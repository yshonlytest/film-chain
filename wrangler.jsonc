{
  "name": "film-chain",
  "main": "src/worker.js",
  "compatibility_date": "2024-12-01",
  "assets": {
    "directory": "public",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "film-chain.onlytest.dev",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
